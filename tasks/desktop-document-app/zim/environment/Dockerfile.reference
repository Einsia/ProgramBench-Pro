FROM program-bench-zim-base:1.0.0
COPY solution /solution
# The black-box runtime: the same files the verifier image installs to drive applications.
COPY environment/runtime/ /opt/blackbox/runtime/
RUN bash /solution/solve.sh && chmod -R u=rwX,go=rX /opt/blackbox/runtime && \
    mkdir -p /reference /blackbox && chown -R root:root /reference /blackbox && \
    chown -R root:root /app/solution && \
    find /app/solution -type d -exec chmod 0711 {} + && \
    find /app/solution -type f -perm /111 -exec chmod 0555 {} + && \
    find /app/solution -type f ! -perm /111 -exec chmod 0444 {} + && rm -rf /solution
ENV PYTHONDONTWRITEBYTECODE=1 LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC TMPDIR=/tmp
# Python imports enumerate the source/package directories; Zim lists installed template categories and files.
RUN chmod 0755 /app/solution/zim-src /app/solution/zim-src/data/templates && \
    find /app/solution/zim-src/zim -type d -exec chmod 0755 {} + && \
    find /app/solution/zim-src/data/templates -mindepth 1 -maxdepth 1 -type d -exec chmod 0755 {} +
# Zim enumerates stock icons in pixmaps during GTK startup.
RUN chmod 0755 /app/solution/zim-src/data/pixmaps
# The version-history dialog enumerates comparison-tool descriptions before showing saved revisions.
RUN chmod 0755 /app/solution/zim-src/data/helpers/compare_files
USER root
ENTRYPOINT ["/usr/bin/tini", "--", "python3", "-I", "-B", "/opt/blackbox/runtime/reference_entrypoint.py"]
CMD ["python3", "-I", "-B", "/opt/blackbox/runtime/broker.py", "--user", "agent", "--socket-mode", "0600", "--log-dir", "/reference/logs"]
