      "rust": "rust-1.94.0-x86_64-unknown-linux-gnu.tar.xz (sha256 e8fa4185f3ef6ae32725ff638b1ecdbff28f5d651dc0b3111e2539350d03b15a)",
      "dependencies": "libsqlite3-dev libcurl4-openssl-dev libssl-dev libxml2-dev libstfl-dev libjson-c-dev libncursesw5-dev gettext pkg-config zlib1g-dev (upstream docker/ubuntu_24.04-build-tools.dockerfile)",
      "command": "cargo fetch --locked && make newsboat; strip --strip-unneeded; patchelf --set-rpath '$ORIGIN/../lib'",
      "sandbox_command": "cc -shared -fPIC -O2 -Wl,--build-id=none pbsandbox.c -o pbsandbox.so -ldl"
