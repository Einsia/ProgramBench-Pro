FROM program-bench-visidata-base:1.0.0
COPY solution /solution
# The runtime drives the reference application through its public interfaces.
COPY environment/runtime/ /opt/blackbox/runtime/
# Keep the installation immutable. Only the three module discovery directories
# below are listable while Python imports VisiData; Landlock denies their later data access.
RUN bash /solution/solve.sh && rm -rf /solution && \
    chmod -R u=rwX,go=rX /opt/blackbox/runtime && \
    mkdir -p /reference /blackbox && chown -R root:root /reference /blackbox && \
    chown -R root:root /app/solution && \
    find /app/solution -type d -exec chmod 0711 {} + && \
    # VisiData enumerates loaders with pkgutil.walk_packages during startup.
    chmod 0755 /app/solution/vdpkg/visidata/loaders && \
    # VisiData enumerates built-in feature modules during startup.
    chmod 0755 /app/solution/vdpkg/visidata/features && \
    # VisiData enumerates built-in theme modules during startup.
    chmod 0755 /app/solution/vdpkg/visidata/themes && \
    find /app/solution -type f -exec chmod 0444 {} + && \
    chmod 0555 /app/solution/start.sh && \
    chmod 0711 /app/solution
ENV PYTHONDONTWRITEBYTECODE=1 LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC TMPDIR=/tmp
USER root
ENTRYPOINT ["/usr/bin/tini", "--", "python3", "-I", "-B", "/opt/blackbox/runtime/reference_entrypoint.py"]
CMD ["python3", "-B", "-I", "/opt/blackbox/runtime/broker.py", "--user", "agent", "--socket-mode", "0600", "--log-dir", "/reference/logs"]
